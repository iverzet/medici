generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  COMPLETED
}

enum ProviderKind {
  DOCTOR
  CLINIC
}

model Doctor {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  title       String
  kind        ProviderKind @default(DOCTOR)
  city        String
  address     String
  phone       String
  email       String
  description String       @db.Text
  photoUrl    String?
  rating      Decimal?     @db.Decimal(2, 1)
  isFeatured  Boolean      @default(false)
  isDemo      Boolean      @default(false)
  services    Json         @default("[]")
  createdAt   DateTime     @default(now())
  leads       Lead[]

  @@index([city, isFeatured])
}

model Lead {
  id             String     @id @default(cuid())
  submissionKey  String?    @unique
  patientName    String
  patientPhone   String
  patientEmail   String?
  city           String
  preferredDate  DateTime?   @db.Date
  message        String?    @db.Text
  doctorId       String?
  doctor         Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  status         LeadStatus @default(NEW)
  consentAt      DateTime
  consentVersion String
  createdAt      DateTime   @default(now())
  notification   Notification?

  @@index([status, createdAt])
  @@index([doctorId])
}

model CityPage {
  id              String @id @default(cuid())
  cityName        String @unique
  slug            String @unique
  metaTitle       String
  metaDescription String
  contentIntro    String @db.Text
}

model PartnershipRequest {
  id            String     @id @default(cuid())
  submissionKey String?    @unique
  clinicName    String
  city          String
  contactName   String
  phone         String
  email         String
  status        LeadStatus @default(NEW)
  consentAt     DateTime
  createdAt     DateTime   @default(now())
  notification  Notification?

  @@index([status, createdAt])
}

model AdminSession {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Notification {
  id            String             @id @default(cuid())
  leadId        String?            @unique
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partnershipId String?            @unique
  partnership   PartnershipRequest? @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, createdAt])
}
model Provider {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  kind           ProviderKind
  description    String       @db.Text
  verification   String       @default("PENDING")
  verifiedAt     DateTime?
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  locations      Location[]
  specialties    ProviderSpecialty[]
  services       ProviderService[]
  credentials    Credential[]

  @@index([isPublished, verification])
}

model Location {
  id         String   @id @default(cuid())
  providerId String
  address    String
  city       String
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  phone      String?
  email      String?
  schedule   Json     @default("{}")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([providerId])
}

model Specialty {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  providers ProviderSpecialty[]
}

model ProviderSpecialty {
  providerId  String
  specialtyId String
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
}

model Service {
  id        String            @id @default(cuid())
  name      String
  duration  Int?
  minPrice  Decimal?          @db.Decimal(10, 2)
  maxPrice  Decimal?          @db.Decimal(10, 2)
  currency  String            @default("RON")
  providers ProviderService[]
}

model ProviderService {
  providerId String
  serviceId  String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

model Credential {
  id         String   @id @default(cuid())
  providerId String
  issuer     String
  reference  String
  verifiedAt DateTime?
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([issuer, reference])
  @@index([providerId])
}
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  targetId  String?
  targetType String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}
